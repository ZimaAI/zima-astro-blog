---
import { Image } from 'astro:assets'
import { profile } from '@/data/profile'

import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { FormattedDate, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import avatar from '@/assets/avatar.png'

const posts = sortMDByDate(await getBlogCollection()).slice(0, 3)
---

<PageLayout meta={{ title: profile.subtitle }}>
  <main class='home'>
    <section class='intro animate' id='content-header' aria-labelledby='intro-title'>
      <div class='intro-copy'>
        <p class='eyebrow'>HELLO, WORLD · {profile.subtitle}</p>
        <h1 id='intro-title'>你好，我是<span>{profile.name}</span>。</h1>
        <p class='intro-lead'>在代码中探索，在记录中成长。</p>
        <p class='intro-description'>
          关注 AI 应用与 Java 后端开发。
          <br class='desktop-break' />这里记录我的技术学习、项目实践与思考。
        </p>
        <div class='intro-links'>
          <a class='primary-link' href='/blog'>阅读文章 <span aria-hidden='true'>↗</span></a>
          <a class='text-link' href={profile.github} target='_blank' rel='noopener noreferrer'>
            <Icon name='github' class='size-4' /> GitHub <span aria-hidden='true'>↗</span>
          </a>
        </div>
      </div>
      <aside class='profile-note' aria-label='个人简介'>
        <div class='note-top'>
          <Image
            src={avatar}
            alt='奇码的头像'
            width={72}
            height={72}
            widths={[72, 144]}
            sizes='72px'
            class='profile-avatar'
            loading='eager'
          />
          <span class='note-label'>DEVELOPER<br />& LEARNER</span>
        </div>
        <p class='note-name'>{profile.handle}<span> / {profile.name}</span></p>
        <p class='note-direction'>{profile.directions.join(' · ')}</p>
        <a class='text-link' href='/about'>更多关于我 <span aria-hidden='true'>↗</span></a>
      </aside>
    </section>

    <div id='content' class='animate home-content'>
      <section class='home-section' aria-labelledby='posts-title'>
        <div class='section-heading'>
          <div><p class='eyebrow'>WRITING</p><h2 id='posts-title'>最近的记录</h2></div>
          <a class='text-link' href='/blog'>全部文章 <span aria-hidden='true'>↗</span></a>
        </div>
        {
          posts.length > 0 ? (
            <ul class='post-list'>
              {posts.map((post) => (
                <li>
                  <a class='post-link' href={`/blog/${post.id}`}>
                    <FormattedDate date={post.data.publishDate} class='post-date' />
                    <div class='post-copy'>
                      <h3>{post.data.title}</h3>
                      <p>{post.data.description}</p>
                    </div>
                    <span class='post-arrow' aria-hidden='true'>
                      ↗
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class='empty-state'>新的记录正在酝酿，欢迎之后再来看看。</p>
          )
        }
      </section>

      <section class='home-section' aria-labelledby='skills-title'>
        <div class='section-heading'>
          <div><p class='eyebrow'>TOOLKIT</p><h2 id='skills-title'>技术栈</h2></div>
        </div>
        <div class='skill-groups'>
          {
            profile.skills.map((group) => (
              <div>
                <h3>{group.title}</h3>
                <ul class='skill-list'>
                  {group.items.map((skill) => (
                    <li>{skill}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
      <div class='closing-note'>
        <span>保持好奇，持续构建。</span>
        <a class='text-link' href='/rss.xml'><Icon name='rss' class='size-4' />订阅 RSS</a>
      </div>
    </div>
  </main>
</PageLayout>

<style>
  .home {
    max-width: 960px;
    margin: 0 auto;
  }
  .intro {
    display: grid;
    grid-template-columns: 1fr 260px;
    align-items: center;
    gap: 56px;
    padding: 42px 0 64px;
  }
  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.16em;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
  }
  h1 {
    margin-top: 24px;
    font-size: clamp(32px, 4.1vw, 46px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.4;
  }
  h1 span {
    color: hsl(var(--primary));
  }
  .intro-lead {
    margin-top: 16px;
    font-size: 20px;
    letter-spacing: 0.015em;
  }
  .intro-description {
    margin-top: 18px;
    font-size: 14px;
    line-height: 2;
    color: hsl(var(--muted-foreground));
  }
  .intro-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: 30px;
  }
  .primary-link {
    display: inline-flex;
    align-items: center;
    gap: 26px;
    border-radius: 8px;
    padding: 11px 19px;
    color: hsl(var(--background));
    background: hsl(var(--foreground));
    font-size: 14px;
  }
  .primary-link:hover {
    background: hsl(var(--primary));
    color: hsl(var(--background));
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
  }
  .profile-note {
    padding: 24px;
    border: 1px solid hsl(var(--border));
    border-radius: 16px;
    background: hsl(var(--primary) / 0.035);
    transform: rotate(2deg);
  }
  .note-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .note-top :global(.profile-avatar) {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    object-fit: cover;
    border: 1px solid hsl(var(--border));
  }
  .note-label {
    font-size: 9px;
    line-height: 1.6;
    letter-spacing: 0.12em;
    color: hsl(var(--muted-foreground));
  }
  .note-name {
    margin-top: 27px;
    font-size: 19px;
    font-weight: 500;
  }
  .note-name span {
    color: hsl(var(--muted-foreground));
    font-size: 12px;
    font-weight: 400;
  }
  .note-direction {
    margin-top: 18px;
    font-size: 11px;
    color: hsl(var(--muted-foreground));
  }
  .profile-note > a {
    margin-top: 20px;
  }
  .home-content {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
  }
  .section-heading h2 {
    margin-top: 7px;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .section-heading > a {
    color: hsl(var(--muted-foreground));
    padding-bottom: 3px;
  }
  .post-list {
    border-top: 1px solid hsl(var(--border));
  }
  .post-link {
    display: grid;
    grid-template-columns: 118px 1fr 20px;
    align-items: start;
    gap: 20px;
    padding: 25px 0;
    border-bottom: 1px solid hsl(var(--border));
  }
  .post-link :global(.post-date) {
    color: hsl(var(--muted-foreground));
    font-size: 12px;
    padding-top: 4px;
  }
  .post-copy h3 {
    font-size: 17px;
    font-weight: 500;
  }
  .post-copy p {
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    margin-top: 8px;
    line-height: 1.8;
  }
  .post-arrow {
    font-size: 20px;
    transition: transform 0.2s;
  }
  .post-link:hover .post-arrow {
    transform: translate(2px, -2px);
  }
  .skill-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .skill-groups h3 {
    margin-bottom: 8px;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }
  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .skill-list li {
    padding: 4px 9px;
    border: 1px solid hsl(var(--border));
    border-radius: 5px;
    font-size: 11px;
  }
  .closing-note {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid hsl(var(--border));
    padding-top: 25px;
    color: hsl(var(--muted-foreground));
    font-size: 13px;
  }
  .empty-state {
    color: hsl(var(--muted-foreground));
    font-size: 14px;
  }
  @media (max-width: 800px) {
    .intro {
      gap: 28px;
      grid-template-columns: 1fr 230px;
    }
    .intro-lead {
      font-size: 18px;
    }
    .desktop-break {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 18px 0 42px;
    }
    .profile-note {
      transform: none;
      padding: 20px;
    }
    .note-top {
      float: right;
      gap: 18px;
    }
    .note-name {
      margin-top: 0;
    }
    .note-direction {
      font-size: 12px;
    }
    .profile-note > a {
      margin-top: 12px;
    }
    .home-content {
      gap: 36px;
    }
    .skill-groups {
      grid-template-columns: 1fr;
      gap: 17px;
    }
    .post-link {
      grid-template-columns: 1fr 20px;
      gap: 10px;
      padding: 20px 0;
    }
    .post-link :global(.post-date) {
      grid-column: 1 / -1;
    }
    .post-copy h3 {
      font-size: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-arrow {
      transition: none;
    }
  }
</style>
