---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  title: '友链',
  description: '奇码博客的友链角落。'
}
---

<PageLayout {meta}>
  <Button title='返回首页' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>友链</h1>
    </div>
    <section id='content' class='animate rounded-2xl border bg-muted/30 p-6 sm:p-8'>
      <h2 class='text-xl font-medium'>留一处相遇的地方</h2>
      <p class='mt-3 leading-7 text-muted-foreground'>
        这里暂时还没有友链。欢迎来我的 GitHub 看看，一起交流学习与开发。
      </p>
      <a
        class='mt-6 inline-flex items-center gap-2 text-primary hover:underline'
        href='https://github.com/ZimaAI'
        target='_blank'
        rel='noopener noreferrer'
      >
        GitHub · ZimaAI <span aria-hidden='true'>↗</span>
      </a>
    </section>
  </main>
</PageLayout>
